{
  "name": "cookbook",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @cookbook/web run dev",
    "build": "pnpm --filter @cookbook/web run build",
    "typecheck": "pnpm --filter @cookbook/web run typecheck",
    "test": "pnpm --filter @cookbook/web run test",
    "deploy": "pnpm --filter @cookbook/web run deploy",
    "db:migrate:local": "pnpm --filter @cookbook/web run db:migrate:local",
    "db:migrate:remote": "pnpm --filter @cookbook/web run db:migrate:remote",
    "lint:check": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "volta": {
    "node": "24.15.0",
    "pnpm": "11.28.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.71.2"
  },
  "engines": {
    "npm": "please-use-pnpm",
    "pnpm": ">=11"
  }
}
