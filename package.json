{
  "name": "cookbook",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @cookbook/web",
    "build": "npm run build -w @cookbook/web",
    "typecheck": "npm run typecheck -w @cookbook/web",
    "test": "npm test -w @cookbook/web",
    "deploy": "npm run deploy -w @cookbook/web",
    "db:migrate:local": "npm run db:migrate:local -w @cookbook/web",
    "db:migrate:remote": "npm run db:migrate:remote -w @cookbook/web",
    "lint:check": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "volta": {
    "node": "24.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.71.2"
  }
}
