{
  "name": "cookbook",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "typegen": "wrangler types && react-router typegen",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:ai": "vitest run --reporter=dot",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile.junit=junit.xml",
    "deploy": "pnpm run build && wrangler deploy",
    "preview": "pnpm run build && vite preview",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:local": "wrangler d1 execute DB --local --file src/db/seed/dev.sql",
    "test:spec": "node scripts/spec-check.ts",
    "lint:check": "oxlint",
    "lint:fix": "oxlint --fix",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write . --list-different",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "isbot": "^5.1.36",
    "jose": "^6.0.0",
    "lucide-react": "^1.59.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.0",
    "@happy-dom/global-registrator": "^21.0.3",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/ui": "^5.0.5",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "happy-dom": "^21.0.3",
    "miniflare": "5.20261012.0-beta",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "vite": "^8.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.148.0"
  },
  "volta": {
    "node": "24.15.0",
    "pnpm": "11.28.6"
  },
  "engines": {
    "npm": "please-use-pnpm",
    "pnpm": ">=11"
  }
}
