/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "cookbook",
	"compatibility_date": "2026-10-06",
	"main": "./workers/app.ts",
	// Only the custom domain is covered by Cloudflare Access, so the Cloudflare-provided addresses stay off
	"workers_dev": false,
	"preview_urls": false,
	"routes": [{ "pattern": "cookbook.rhythm-coder.dev", "custom_domain": true }],
	"vars": {
		// Zero Trust team domain, e.g. "myteam.cloudflareaccess.com"
		"ACCESS_TEAM_DOMAIN": "dawn-rice-f776.cloudflareaccess.com",
		// Audience (AUD) tag of the Access application
		"ACCESS_AUD": "3834480a19a3287e47ddbcfbc78fc8e89bf885accf907ddc0e6970bed203de81"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "cookbook",
			"database_id": "d585103f-aad1-4214-a9a5-70e70cf87af2",
			"migrations_dir": "migrations"
		}
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
