/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cookbook",
  "compatibility_date": "2026-10-06",
  "main": "./src/workers/app.ts",
  // Only the custom domain is covered by Cloudflare Access, so the Cloudflare-provided addresses stay off
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "cookbook.rhythm-coder.dev", "custom_domain": true }],
  "vars": {
    // Zero Trust team domain, e.g. "myteam.cloudflareaccess.com"
    "ACCESS_TEAM_DOMAIN": "dawn-rice-f776.cloudflareaccess.com",
    // Audience (AUD) tag of the Access application
    "ACCESS_AUD": "3834480a19a3287e47ddbcfbc78fc8e89bf885accf907ddc0e6970bed203de81",
    // Email of the member who becomes superadmin when they are welcomed, as long as no superadmin exists yet
    "SUPERADMIN_EMAIL": "info@rhythm-coder.dev",
    // Where the family allowlist (Access > Policies) is managed; linked from the delete-user popup. Placeholder: the Zero Trust dashboard start page, fill in the exact policy link
    "CLOUDFLARE_ACCESS_URL": "https://one.dash.cloudflare.com/",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cookbook",
      "database_id": "d585103f-aad1-4214-a9a5-70e70cf87af2",
      "migrations_dir": "src/db/migrations",
    },
  ],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "cookbook-photos" }],
  // Caps the fetch endpoints of the recipe import: 30 per minute per family member (the key is the member's email)
  "ratelimits": [{ "name": "IMPORT_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }],
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
}
